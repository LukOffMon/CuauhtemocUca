{
  "name": "mi-horario",
  "version": "3.0.0",
  "description": "Mi Horario Escolar: horario, exámenes, tareas de Moodle y ALEKS, Pomodoro, promedios, faltas y notas, con cuentas de usuario y datos cifrados.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "keys": "node scripts/generate-keys.js",
    "backup-db": "node scripts/backup-db.js",
    "rotate-key": "node scripts/rotate-data-key.js",
    "test": "node --test \"backend/test/**/*.test.js\"",
    "check": "node --check backend/src/server.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  }
}
