# Ejemplo si prefieres Nginx + Certbot en lugar de Caddy.
# sudo certbot --nginx -d horario.midominio.mx
server {
    listen 80;
    server_name horario.midominio.mx;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name horario.midominio.mx;

    ssl_certificate     /etc/letsencrypt/live/horario.midominio.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/horario.midominio.mx/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 1m;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
