# ---------------------------------------------------------------
# Mi Horario — variables de entorno
# Copia este archivo a .env y ejecuta:  npm run keys
# NUNCA subas .env a GitHub (ya está en .gitignore).
# ---------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# URL pública exacta de la app (sin "/" final). En producción debe ser https://
# Se usa para validar el encabezado Origin (protección CSRF).
APP_ORIGIN=http://localhost:3000

# Proxies de confianza delante de la app (Caddy/Nginx/Render/Railway = 1). Directo = 0.
TRUST_PROXY=0

# Ruta del archivo SQLite (cifrado con SQLCipher).
DATABASE_PATH=data/mi-horario.db

# --- Claves (genera con: npm run keys) ---
# Cifrado del archivo completo de la base (SQLCipher, AES-256). 64 caracteres hex.
DB_ENCRYPTION_KEY=
# Cifrado por campo (AES-256-GCM). 32 bytes en base64.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# Claves anteriores para rotación, separadas por coma:  k0:base64,k00:base64
DATA_ENCRYPTION_KEYS_OLD=
# HMAC para buscar correos sin guardarlos en claro. 32 bytes en base64. No la cambies después de crear cuentas.
BLIND_INDEX_KEY=

# --- Seguridad de cuentas ---
BCRYPT_ROUNDS=12
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ALLOW_REGISTRATION=true

# --- Varios ---
WEATHER_ENABLED=true
# Zona horaria del horario de ejemplo (Aguascalientes / Ciudad de México = -06:00)
SEED_TZ_OFFSET=-06:00
LOG_REQUESTS=true
